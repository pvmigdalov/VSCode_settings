        "[Wired]": {
            // "editor.background": "#040201",
            "editorBracketHighlight.foreground1": "#ff5c8a",
            "editorBracketHighlight.foreground2": "#fa8588",
            "editorBracketHighlight.foreground3": "#ffa0a0",
            "editorBracketHighlight.foreground4": "#d9a0e8",
            "editorBracketHighlight.foreground5": "#b06aff",
            "editorBracketHighlight.foreground6": "#c77dff",
            "editorBracketHighlight.unexpectedBracket.foreground": "#ff0000"
        }
    },
    "editor.tokenColorCustomizations": {
        "[Wired]": {
            "comments": "#a05a6e",
            "strings": "#f0b8a8",
            "keywords": "#ff5c8a",
            "functions": "#fa8588",
            "types": "#e0b8a8",
            "variables": "#f0d8b0",
            "numbers": "#e0a098",
            "textMateRules": [
                {
                    "scope": [
                        "keyword.operator",
                        "keyword.operator.arithmetic",
                        "keyword.operator.comparison",
                        "keyword.operator.logical",
                        "keyword.operator.assignment"
                    ],
                    "settings": {
                        "foreground": "#ff5c8a"
                    }
                },
                {
                    "scope": [
                        "entity.name.function",
                        "entity.name.function.python",
                        "meta.function-call.python",
                        "meta.function-call.generic.python",
                        "meta.function-call.object.python",
                        "meta.function-call.static.python",
                        "support.function.builtin.python",
                        "support.function.python"
                    ],
                    "settings": {
                        "foreground": "#fa8588"
                    }
                },
                {
                    "scope": [
                        "storage.type.function.python",
                        "storage.type.function.async.python",
                        "storage.type.class.python",
                        "keyword.control.flow.python",
                        "keyword.control.async.python",
                        "storage.modifier.async.python"
                    ],
                    "settings": {
                        "foreground": "#ff5c8a",
                        "fontStyle": "italic"
                    }
                },
                {
                    "scope": [
                        "variable.other.readwrite",
                        "eta.object-literal.key",
                        "support.variable.property",
                        "support.variable.object.process",
                        "support.variable.object.node"
                    ],
                    "settings": {
                        "foreground": "#e0afc0",
                    }
                },
                {
                    "scope": [
                        "support.type.property-name.json.comments",
                        "string.json.comments",
                        "meta.structure.dictionary.json.comments",
                        "meta.structure.array.json.comments",
                        "meta.structure.dictionary.value.json.comments",
                        "meta.structure.dictionary.json.comments",
                        "meta.structure.dictionary.value.json.comments",
                        "meta.structure.dictionary.json.comments",
                        "meta.structure.dictionary.value.json.comments",
                        "meta.structure.dictionary.json.comments",
                        "source.json.comments",
                        "support.type.property-name.json",
                        "string.json",
                        "meta.structure.dictionary.json",
                        "meta.structure.dictionary.value.json",
                        "meta.structure.dictionary.json",
                        "source.json"
                    ],
                    "settings": {
                        "foreground": "#e0afc0",
                    }
                }
            ]
        }
    },
